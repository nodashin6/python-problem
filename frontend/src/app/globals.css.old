@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #171717;
  --muted: #6b7280;
  --subtle: #9ca3af;
  --border: #e5e7eb;
  --primary: #4338ca;
  /* indigo-700 */
  --primary-light: #6366f1;
  /* indigo-500 */
  --primary-dark: #312e81;
  /* indigo-900 */
  --secondary: #a21caf;
  /* purple-700 */
  --secondary-light: #c026d3;
  /* purple-600 */
  --secondary-dark: #701a75;
  /* purple-900 */
  --success: #10b981;
  /* emerald-500 */
  --warning: #f59e0b;
  /* amber-500 */
  --error: #ef4444;
  /* red-500 */
  --info: #3b82f6;
  /* blue-500 */
  --card-bg: #ffffff;
  --card-border: #e5e7eb;
  --gradient-start: #ede9fe;
  /* indigo-50 */
  --gradient-end: #f5f3ff;
  /* purple-50 */
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
  --radius-sm: 0.25rem;
  --radius: 0.5rem;
  --radius-md: 0.75rem;
  --radius-lg: 1rem;
  --radius-xl: 1.5rem;
  --radius-2xl: 2rem;
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0f172a;
    /* slate-900 */
    --foreground: #f1f5f9;
    /* slate-100 */
    --muted: #94a3b8;
    /* slate-400 */
    --subtle: #64748b;
    /* slate-500 */
    --border: #334155;
    /* slate-700 */
    --card-bg: #1e293b;
    /* slate-800 */
    --card-border: #475569;
    /* slate-600 */
    --gradient-start: #1e1b4b;
    /* indigo-900 */
    --gradient-end: #581c87;
    /* purple-900 */
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.3);
    --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.4), 0 1px 2px -1px rgb(0 0 0 / 0.4);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.4), 0 2px 4px -2px rgb(0 0 0 / 0.4);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.4), 0 4px 6px -4px rgb(0 0 0 / 0.4);
    --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.4), 0 8px 10px -6px rgb(0 0 0 / 0.4);
  }
}

[data-theme="dark"] {
  --background: #0f172a;
  /* slate-900 */
  --foreground: #f1f5f9;
  /* slate-100 */
  --muted: #94a3b8;
  /* slate-400 */
  --subtle: #64748b;
  /* slate-500 */
  --border: #334155;
  /* slate-700 */
  --card-bg: #1e293b;
  /* slate-800 */
  --card-border: #475569;
  /* slate-600 */
  --gradient-start: #1e1b4b;
  /* indigo-900 */
  --gradient-end: #581c87;
  /* purple-900 */
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.3);
  --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.4), 0 1px 2px -1px rgb(0 0 0 / 0.4);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.4), 0 2px 4px -2px rgb(0 0 0 / 0.4);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.4), 0 4px 6px -4px rgb(0 0 0 / 0.4);
  --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.4), 0 8px 10px -6px rgb(0 0 0 / 0.4);
}


/* @media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
} */

* {
  border-color: var(--border);
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
  transition: background-color 0.3s ease, color 0.3s ease;
}

/* ボタンコンポーネント */
.btn {
  @apply inline-flex items-center justify-center font-medium text-sm transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed;
}

.btn-primary {
  @apply btn px-6 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-xl hover:shadow-lg hover:shadow-indigo-500/25 transform hover:-translate-y-0.5 focus:ring-indigo-500 active:transform active:translate-y-0;
}

.btn-secondary {
  @apply btn px-6 py-3 bg-white text-indigo-600 border border-indigo-200 rounded-xl hover:bg-indigo-50 hover:shadow-md hover:shadow-indigo-100 transform hover:-translate-y-0.5 focus:ring-indigo-500 active:transform active:translate-y-0;
}

.btn-outline {
  @apply btn px-6 py-3 bg-transparent text-indigo-600 border border-indigo-300 rounded-xl hover:bg-indigo-600 hover:text-white hover:border-indigo-600 hover:shadow-md focus:ring-indigo-500;
}

.btn-ghost {
  @apply btn px-6 py-3 text-indigo-600 hover:bg-indigo-100 rounded-xl focus:ring-indigo-500;
}

.btn-danger {
  @apply btn px-6 py-3 bg-red-600 text-white rounded-xl hover:bg-red-700 hover:shadow-lg hover:shadow-red-500/25 transform hover:-translate-y-0.5 focus:ring-red-500 active:transform active:translate-y-0;
}

.btn-success {
  @apply btn px-6 py-3 bg-green-600 text-white rounded-xl hover:bg-green-700 hover:shadow-lg hover:shadow-green-500/25 transform hover:-translate-y-0.5 focus:ring-green-500 active:transform active:translate-y-0;
}

/* ボタンサイズバリエーション */
.btn-sm {
  @apply px-4 py-2 text-xs;
}

.btn-lg {
  @apply px-8 py-4 text-base;
}

/* カードコンポーネント */
.card {
  background: var(--card-bg);
  border-color: var(--card-border);
  border-radius: 0.75rem;
  border-width: 1px;
  box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
  transition: all 0.3s ease;
}

.card-modern {
  background: var(--card-bg);
  border-color: var(--primary-light);
  border-radius: 1rem;
  border-width: 1px;
  box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
  transition: all 0.3s ease;
}

.card-modern:hover {
  box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
}

.card-elevated {
  background: var(--card-bg);
  border-color: var(--card-border);
  border-radius: 0.75rem;
  border-width: 1px;
  box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  transition: all 0.3s ease;
}

.card-elevated:hover {
  box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
}

.card-flat {
  background: var(--card-bg);
  border-color: var(--card-border);
  border-radius: 0.75rem;
  border-width: 1px;
  box-shadow: none;
  transition: all 0.3s ease;
}

.card-flat:hover {
  box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
}

.card-header {
  background: linear-gradient(to right, #4338ca, #a855f7);
  padding: 1rem 1.5rem;
  color: white;
}

.card-header-simple {
  border-bottom-color: var(--border);
  border-bottom-width: 1px;
  padding: 1rem 1.5rem;
}

.card-body {
  padding: 1.5rem;
}

.card-footer {
  background: var(--gradient-start);
  border-top-color: var(--border);
  border-top-width: 1px;
  padding: 1rem 1.5rem;
}

/* レイアウトとページ */
.page-gradient {
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
  @apply min-h-screen py-10 px-4;
}

.page-container {
  @apply max-w-7xl mx-auto px-4 sm:px-6 lg:px-8;
}

.section {
  @apply py-16;
}

.section-sm {
  @apply py-8;
}

.section-lg {
  @apply py-24;
}

/* ローディング表示 */
.loading-spinner {
  @apply w-6 h-6 border-4 border-indigo-500 border-t-transparent rounded-full animate-spin;
}

.loading-dots {
  @apply inline-flex space-x-1;
}

.loading-dots span {
  @apply w-2 h-2 bg-indigo-500 rounded-full animate-pulse;
  animation-delay: calc(var(--i) * 200ms);
}

/* リンクとナビゲーション */
.link-primary {
  @apply inline-flex items-center text-indigo-600 hover:text-indigo-800 font-medium transition-all duration-300;
}

.link-secondary {
  @apply text-gray-600 hover:text-gray-900 transition-colors duration-200;
}

.nav-link {
  @apply px-3 py-2 text-sm font-medium rounded-lg transition-all duration-200 hover:bg-indigo-100 hover:text-indigo-700 focus:bg-indigo-100 focus:text-indigo-700;
}

/* フォーム要素 */
.form-input {
  background: var(--card-bg);
  border-color: var(--border);
  color: var(--foreground);
  @apply w-full px-4 py-3 border rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200;
}

.form-input::placeholder {
  color: var(--subtle);
}

.form-textarea {
  @apply form-input resize-none;
}

.form-select {
  @apply form-input cursor-pointer;
}

.form-label {
  color: var(--foreground);
  @apply block text-sm font-medium mb-2;
}

.form-error {
  @apply text-sm text-red-600 mt-1;
}

/* ステータス表示 */
.status-success {
  @apply inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800;
}

.status-error {
  @apply inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800;
}

.status-warning {
  @apply inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800;
}

.status-info {
  @apply inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800;
}

/* アラートコンポーネント */
.alert {
  @apply p-4 rounded-xl border-l-4;
}

.alert-success {
  @apply alert bg-green-50 border-green-500 text-green-700;
}

.alert-error {
  @apply alert bg-red-50 border-red-500 text-red-700;
}

.alert-warning {
  @apply alert bg-yellow-50 border-yellow-500 text-yellow-700;
}

.alert-info {
  @apply alert bg-blue-50 border-blue-500 text-blue-700;
}

/* テストケースの結果表示用スタイル */
.test-result-box {
  @apply bg-gray-50 rounded-lg p-4 shadow-inner border border-gray-200;
}

/* タイポグラフィ */
.heading-xl {
  @apply text-4xl md:text-5xl font-bold tracking-tight;
}

.heading-lg {
  @apply text-3xl md:text-4xl font-bold tracking-tight;
}

.heading-md {
  @apply text-2xl md:text-3xl font-bold tracking-tight;
}

.heading-sm {
  @apply text-xl md:text-2xl font-semibold tracking-tight;
}

.text-muted {
  color: var(--muted);
}

.text-subtle {
  color: var(--subtle);
}

/* アニメーション */
.animate-fade-in {
  animation: fadeIn 0.5s ease-in-out;
}

.animate-slide-up {
  animation: slideUp 0.5s ease-out;
}

.animate-scale-in {
  animation: scaleIn 0.3s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* レスポンシブユーティリティ */
.container-responsive {
  width: 100%;
  max-width: 80rem;
  margin-left: auto;
  margin-right: auto;
  padding-left: 1rem;
  padding-right: 1rem;
}

@media (min-width: 640px) {
  .container-responsive {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}

@media (min-width: 1024px) {
  .container-responsive {
    padding-left: 2rem;
    padding-right: 2rem;
  }
}

.grid-responsive {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1rem;
}

@media (min-width: 640px) {
  .grid-responsive {
    gap: 1.5rem;
  }
}

@media (min-width: 1024px) {
  .grid-responsive {
    gap: 2rem;
  }
}

.grid-responsive-2 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 1rem;
}

@media (min-width: 640px) {
  .grid-responsive-2 {
    gap: 1.5rem;
  }
}

@media (min-width: 1024px) {
  .grid-responsive-2 {
    gap: 2rem;
  }
}

.grid-responsive-3 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1rem;
}

@media (min-width: 640px) {
  .grid-responsive-3 {
    gap: 1.5rem;
  }
}

@media (min-width: 1024px) {
  .grid-responsive-3 {
    gap: 2rem;
  }
}

.flex-responsive {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

@media (min-width: 640px) {
  .flex-responsive {
    flex-direction: row;
    gap: 1.5rem;
  }
}

.text-responsive {
  font-size: 0.875rem;
  line-height: 1.25rem;
}

@media (min-width: 640px) {
  .text-responsive {
    font-size: 1rem;
    line-height: 1.5rem;
  }
}

@media (min-width: 1024px) {
  .text-responsive {
    font-size: 1.125rem;
    line-height: 1.75rem;
  }
}

.text-responsive-lg {
  font-size: 1.125rem;
  line-height: 1.75rem;
}

@media (min-width: 640px) {
  .text-responsive-lg {
    font-size: 1.25rem;
    line-height: 1.75rem;
  }
}

@media (min-width: 1024px) {
  .text-responsive-lg {
    font-size: 1.5rem;
    line-height: 2rem;
  }
}

.text-responsive-xl {
  font-size: 1.25rem;
  line-height: 1.75rem;
}

@media (min-width: 640px) {
  .text-responsive-xl {
    font-size: 1.5rem;
    line-height: 2rem;
  }
}

@media (min-width: 1024px) {
  .text-responsive-xl {
    font-size: 1.875rem;
    line-height: 2.25rem;
  }
}

@media (min-width: 1280px) {
  .text-responsive-xl {
    font-size: 2.25rem;
    line-height: 2.5rem;
  }
}

.spacing-responsive {
  padding-top: 2rem;
  padding-bottom: 2rem;
}

@media (min-width: 640px) {
  .spacing-responsive {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
}

@media (min-width: 1024px) {
  .spacing-responsive {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
}

@media (min-width: 1280px) {
  .spacing-responsive {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }
}

.spacing-responsive-sm {
  padding-top: 1rem;
  padding-bottom: 1rem;
}

@media (min-width: 640px) {
  .spacing-responsive-sm {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
}

@media (min-width: 1024px) {
  .spacing-responsive-sm {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }
}

/* モバイルファーストな表示制御 */
.mobile-only {
  display: block;
}

@media (min-width: 640px) {
  .mobile-only {
    display: none;
  }
}

.tablet-up {
  display: none;
}

@media (min-width: 640px) {
  .tablet-up {
    display: block;
  }
}

.desktop-only {
  display: none;
}

@media (min-width: 1024px) {
  .desktop-only {
    display: block;
  }
}

/* レスポンシブタイポグラフィ */
.heading-responsive {
  font-size: 1.5rem;
  line-height: 2rem;
  font-weight: 700;
  letter-spacing: -0.025em;
}

@media (min-width: 640px) {
  .heading-responsive {
    font-size: 1.875rem;
    line-height: 2.25rem;
  }
}

@media (min-width: 1024px) {
  .heading-responsive {
    font-size: 2.25rem;
    line-height: 2.5rem;
  }
}

@media (min-width: 1280px) {
  .heading-responsive {
    font-size: 3rem;
    line-height: 1;
  }
}

.heading-responsive-sm {
  font-size: 1.25rem;
  line-height: 1.75rem;
  font-weight: 700;
  letter-spacing: -0.025em;
}

@media (min-width: 640px) {
  .heading-responsive-sm {
    font-size: 1.5rem;
    line-height: 2rem;
  }
}

@media (min-width: 1024px) {
  .heading-responsive-sm {
    font-size: 1.875rem;
    line-height: 2.25rem;
  }
}

/* レスポンシブスペーシング */
@media (max-width: 640px) {
  .card-body {
    @apply p-4;
  }

  .btn {
    @apply px-4 py-2.5 text-sm;
  }

  .btn-lg {
    @apply px-6 py-3 text-base;
  }
}

/* アクセシビリティ改善 */
.focus-visible {
  @apply focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2;
}

.screen-reader-only {
  @apply sr-only;
}

/* 高コントラストモード対応 */
@media (prefers-contrast: high) {
  .btn-primary {
    @apply border-2 border-white;
  }

  .card-modern {
    @apply border-2;
  }
}

/* 動画の削減を希望するユーザー向け */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  .animate-spin {
    animation: none;
  }
}

/* キーボードナビゲーション改善 */
.skip-link {
  @apply absolute -top-10 left-4 z-50 bg-indigo-600 text-white px-4 py-2 rounded-md focus:top-4 transition-all duration-200;
}

/* フォーカス表示の改善 */
.form-input:focus,
.btn:focus,
button:focus,
a:focus {
  @apply outline-none ring-2 ring-indigo-500 ring-offset-2;
}

/* ARIAライブリージョンのスタイル */
.live-region {
  @apply sr-only;
}

[aria-live="polite"],
[aria-live="assertive"] {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Tailwind基本ユーティリティ */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

.block {
  display: block;
}

.inline-block {
  display: inline-block;
}

.inline {
  display: inline;
}

.flex {
  display: flex;
}

.inline-flex {
  display: inline-flex;
}

.grid {
  display: grid;
}

.hidden {
  display: none;
}

.flex-col {
  flex-direction: column;
}

.flex-row {
  flex-direction: row;
}

.items-center {
  align-items: center;
}

.items-start {
  align-items: flex-start;
}

.items-end {
  align-items: flex-end;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.justify-start {
  justify-content: flex-start;
}

.justify-end {
  justify-content: flex-end;
}

.w-full {
  width: 100%;
}

.w-auto {
  width: auto;
}

.w-4 {
  width: 1rem;
}

.w-5 {
  width: 1.25rem;
}

.w-6 {
  width: 1.5rem;
}

.w-8 {
  width: 2rem;
}

.w-16 {
  width: 4rem;
}

.w-20 {
  width: 5rem;
}

.h-4 {
  height: 1rem;
}

.h-5 {
  height: 1.25rem;
}

.h-6 {
  height: 1.5rem;
}

.h-8 {
  height: 2rem;
}

.h-16 {
  height: 4rem;
}

.h-20 {
  height: 5rem;
}

.min-h-screen {
  min-height: 100vh;
}

.max-w-3xl {
  max-width: 48rem;
}

.max-w-4xl {
  max-width: 56rem;
}

.max-w-5xl {
  max-width: 64rem;
}

.max-w-6xl {
  max-width: 72rem;
}

.max-w-7xl {
  max-width: 80rem;
}

.max-w-lg {
  max-width: 32rem;
}

.max-w-md {
  max-width: 28rem;
}

.mx-auto {
  margin-left: auto;
  margin-right: auto;
}

.mb-2 {
  margin-bottom: 0.5rem;
}

.mb-3 {
  margin-bottom: 0.75rem;
}

.mb-4 {
  margin-bottom: 1rem;
}

.mb-6 {
  margin-bottom: 1.5rem;
}

.mb-8 {
  margin-bottom: 2rem;
}

.mb-10 {
  margin-bottom: 2.5rem;
