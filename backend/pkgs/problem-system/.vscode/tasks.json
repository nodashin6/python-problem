{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Poetry: Run Tests",
            "type": "shell",
            "command": "poetry",
            "args": [
                "run",
                "pytest"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": "$pytest"
        },
        {
            "label": "Poetry: Run Specific Test",
            "type": "shell",
            "command": "poetry",
            "args": [
                "run",
                "pytest",
                "${input:testPath}"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": "$pytest"
        },
        {
            "label": "Poetry: Run Tests with Coverage",
            "type": "shell",
            "command": "poetry",
            "args": [
                "run",
                "pytest",
                "--cov"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": "$pytest"
        }
    ],
    "inputs": [
        {
            "id": "testPath",
            "description": "Path to the test file or directory",
            "default": "tests/",
            "type": "promptString"
        }
    ]
}